# --- Configuration du bot -----------------------------------------------------
# Option A (recommandée) : laisser ces deux variables vides et saisir l'ID admin
# + le token dans la page "/" du site après le déploiement (enregistrés une
# seule fois dans DATA_DIR/murad-bot.json).
# Option B : les définir ici / dans les variables de la plateforme. Dans ce cas
# la page de configuration est désactivée.
TELEGRAM_BOT_TOKEN=""
ADMIN_IDS=""

# Mot de passe de la page de configuration "/". CHANGEZ-LE : la valeur par
# défaut est visible dans le code source.
MURAD_SETUP_PASSWORD=""

# APP_URL: (optionnel) domaine public. Sinon détecté automatiquement.
APP_URL=""

# PORT: injecté par la plateforme. Défaut : 8080.
# KEEP_ALIVE_INTERVAL: secondes entre deux pings automatiques (défaut : 30).
# DATA_DIR: dossier persistant (scripts, config, domaine). Défaut : /app/data.
